{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aicoach-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Hourly: release stale credit holds. Nightly 02:00 IST: sync OpenRouter models & prices.
  "triggers": { "crons": ["0 * * * *", "30 20 * * *"] },

  // The web app (apps/admin-web) is built into ../admin-web/dist and served by this Worker.
  // /api/* always goes to the Worker; everything else is the SPA.
  "assets": {
    "directory": "../admin-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Local development. `database_id` is a placeholder for local mode only; staging/production
  // ids come from `wrangler d1 create` (see docs/progress.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aicoach-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Shared textbook content store (architecture §3.3, decision 9.4-1): the SAME index and bucket for
  // LOCAL and STAGING, so a PDF is processed once. LOCAL reaches them remotely. Only ever add to them.
  "vectorize": [
    { "binding": "CONTENT_VECTORS", "index_name": "aicoach-content-chunks", "remote": true },
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "aicoach-content", "remote": true }],
  // Workers AI (embeddings @cf/baai/bge-m3, reranker); always runs on Cloudflare, even locally.
  "ai": { "binding": "AI", "remote": true },
  // Textbook ingestion runs as a durable Workflow (LOCAL: where books are processed).
  "workflows": [
    { "name": "aicoach-ingest-book", "binding": "INGEST_BOOK", "class_name": "IngestBookWorkflow" },
    // Exam strategy from board material (LOCAL only; staging imports the result).
    {
      "name": "aicoach-compile-strategy",
      "binding": "COMPILE_STRATEGY",
      "class_name": "CompileStrategyWorkflow",
    },
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:8787",
    "WEB_ORIGIN": "http://localhost:5173",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "AI Coach <onboarding@resend.dev>",
    // Cloudflare's public Turnstile test site key: always passes. Real keys are set per environment.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  // Secrets (set with `wrangler secret put` or in .dev.vars locally):
  //   BETTER_AUTH_SECRET, RESEND_API_KEY, TURNSTILE_SECRET_KEY

  "env": {
    "staging": {
      "name": "aicoach-api-staging",
      "triggers": { "crons": ["0 * * * *", "30 20 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aicoach-staging",
          "database_id": "d1cc7789-d5f0-4de1-a872-ef0c8cd765f4",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "vectorize": [{ "binding": "CONTENT_VECTORS", "index_name": "aicoach-content-chunks" }],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "aicoach-content" }],
      "ai": { "binding": "AI" },
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://aicoach-api-staging.jameel-outskill.workers.dev",
        "WEB_ORIGIN": "https://aicoach-api-staging.jameel-outskill.workers.dev",
        "EMAIL_PROVIDER": "console", // codes visible via `wrangler tail --env staging`; switch to "resend" once a key + domain exist
        "EMAIL_FROM": "AI Coach <onboarding@resend.dev>",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
    },
  },
}
