{
  "name": "aicoach",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:worker": "pnpm --filter @aicoach/worker dev",
    "dev:web": "pnpm --filter @aicoach/admin-web dev",
    "dev:mobile": "pnpm --filter @aicoach/mobile start",
    "dev:mobile:staging": "pnpm --filter @aicoach/mobile start:staging",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aicoach/db generate",
    "db:migrate:local": "pnpm --filter @aicoach/worker db:migrate:local",
    "db:seed:local": "pnpm --filter @aicoach/worker db:seed:local",
    "cleanup-test:local": "pnpm --filter @aicoach/worker db:cleanup-test:local",
    "upload-board:local": "node apps/worker/scripts/upload-board-material.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:staging": "pnpm --filter @aicoach/admin-web build && pnpm --filter @aicoach/worker deploy:staging",
    "logs:staging": "pnpm --filter @aicoach/worker logs:staging",
    "make-admin:local": "pnpm --filter @aicoach/worker db:make-admin:local --",
    "make-admin:staging": "pnpm --filter @aicoach/worker make-admin:staging --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
